// 音声メモキャプチャの UI。
// 都度起動の小窓。4つの画面（録音中/送信中/失敗/停止）を screen プロパティで切り替える。

// 画面の種類。
export enum Screen {
    recording,   // 録音中
    sending,     // 送信中
    failed,      // 送信失敗（再送信可）
    blocked,     // デバイス未検出・回復不能エラー（閉じるのみ）
}

// 配色（落ち着いた単一テーマ）。
global Palette {
    out property <color> bg: #f5f5f7;
    out property <color> card: #ffffff;
    out property <color> text: #1c1c1e;
    out property <color> subtle: #6b6b70;
    out property <color> accent: #e0483d;      // 録音・主要動作（レッド）
    out property <color> send: #2f6bd6;         // 送信（ブルー）
    out property <color> border: #dcdce1;
    out property <color> danger-bg: #fdecea;
}

// 主要動作ボタン（塗り）。
component PrimaryButton inherits Rectangle {
    in property <string> text;
    in property <color> accent: Palette.send;
    callback clicked();

    height: 42px;
    border-radius: 9px;
    background: touch.pressed
        ? root.accent.darker(15%)
        : (touch.has-hover ? root.accent.brighter(8%) : root.accent);
    animate background { duration: 90ms; }

    Text {
        text: root.text;
        color: white;
        font-size: 15px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// 副次動作ボタン（枠線のみ）。
component GhostButton inherits Rectangle {
    in property <string> text;
    callback clicked();

    height: 42px;
    border-radius: 9px;
    border-width: 1px;
    border-color: Palette.border;
    background: touch.pressed
        ? #ececf0
        : (touch.has-hover ? #f7f7fa : transparent);
    animate background { duration: 90ms; }

    Text {
        text: root.text;
        color: Palette.subtle;
        font-size: 15px;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component AppWindow inherits Window {
    in property <Screen> screen: Screen.recording;
    in property <string> elapsed: "0:00";
    in property <string> message;
    in property <string> detail;

    callback finish-send();
    callback discard();
    callback retry();
    callback dismiss();

    title: "音声メモ";
    icon: @image-url("../assets/icon.png");
    width: 400px;
    height: 200px;
    background: Palette.bg;

    // カード
    Rectangle {
        x: 14px;
        y: 14px;
        width: parent.width - 28px;
        height: parent.height - 28px;
        background: Palette.card;
        border-radius: 14px;
        border-width: 1px;
        border-color: Palette.border;

        VerticalLayout {
            padding: 18px;
            spacing: 16px;

            // ── 録音中 ──
            if root.screen == Screen.recording: HorizontalLayout {
                spacing: 12px;
                // 録音インジケータ（パルスする赤ドット）。
                Rectangle {
                    width: 16px;
                    height: 16px;
                    border-radius: 8px;
                    background: Palette.accent;
                    // animation-tick() で連続的に脈打たせる（0.35〜1.0）。
                    opacity: 0.35 + 0.65 * (0.5 + 0.5 * cos(animation-tick() / 1000ms * 360deg));
                }
                Text {
                    text: "録音中";
                    font-size: 17px;
                    font-weight: 600;
                    color: Palette.text;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Text {
                    text: root.elapsed;
                    font-size: 24px;
                    font-weight: 700;
                    color: Palette.text;
                    vertical-alignment: center;
                }
            }

            // ── 送信中 ──
            if root.screen == Screen.sending: HorizontalLayout {
                spacing: 10px;
                alignment: center;
                // 3つのドットが位相をずらして脈打つスピナー。
                for i in 3: Rectangle {
                    width: 9px;
                    height: 9px;
                    border-radius: 4.5px;
                    background: Palette.send;
                    opacity: 0.25 + 0.75 * (0.5 + 0.5 * cos(animation-tick() / 800ms * 360deg - i * 120deg));
                }
                Text {
                    text: "送信中…";
                    font-size: 17px;
                    font-weight: 600;
                    color: Palette.text;
                    vertical-alignment: center;
                }
            }

            // ── 送信失敗 ──
            if root.screen == Screen.failed: VerticalLayout {
                spacing: 6px;
                Text {
                    text: "送信に失敗しました";
                    font-size: 16px;
                    font-weight: 700;
                    color: Palette.accent;
                }
                Text {
                    text: root.message;
                    font-size: 13px;
                    color: Palette.text;
                    wrap: word-wrap;
                }
                Text {
                    text: root.detail;
                    font-size: 11px;
                    color: Palette.subtle;
                    wrap: word-wrap;
                    visible: root.detail != "";
                }
            }

            // ── 停止（デバイス未検出・エラー）──
            if root.screen == Screen.blocked: VerticalLayout {
                spacing: 6px;
                Text {
                    text: root.message;
                    font-size: 14px;
                    color: Palette.text;
                    wrap: word-wrap;
                }
                Text {
                    text: root.detail;
                    font-size: 11px;
                    color: Palette.subtle;
                    wrap: word-wrap;
                    visible: root.detail != "";
                }
            }

            // ── ボタン行 ──
            if root.screen == Screen.recording: HorizontalLayout {
                spacing: 10px;
                PrimaryButton {
                    text: "送信";
                    accent: Palette.send;
                    horizontal-stretch: 1;
                    clicked => { root.finish-send(); }
                }
                GhostButton {
                    text: "破棄";
                    horizontal-stretch: 1;
                    clicked => { root.discard(); }
                }
            }
            if root.screen == Screen.failed: HorizontalLayout {
                spacing: 10px;
                PrimaryButton {
                    text: "再送信";
                    accent: Palette.send;
                    horizontal-stretch: 1;
                    clicked => { root.retry(); }
                }
                GhostButton {
                    text: "閉じる";
                    horizontal-stretch: 1;
                    clicked => { root.dismiss(); }
                }
            }
            if root.screen == Screen.blocked: HorizontalLayout {
                GhostButton {
                    text: "閉じる";
                    horizontal-stretch: 1;
                    clicked => { root.dismiss(); }
                }
            }
        }
    }
}
