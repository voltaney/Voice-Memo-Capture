# n8n Webhook の受け口URL（素のURL。?source=pc はプログラム側で付与する）
N8N_WEBHOOK_URL=https://your-n8n-domain/webhook/xxxxx
# Basic認証のユーザー名
N8N_BASIC_AUTH_USER=your_username
# Basic認証のパスワード
N8N_BASIC_AUTH_PASS=your_password
# 録音に使う入力デバイス名（部分一致で検索。未接続なら録音せず安全に停止する）
# スペースを含む値は必ず "..." で囲む（囲まないと .env の解析に失敗する）
TARGET_DEVICE_NAME="Microphone (USB MICROPHONE)"
# 送信する Ogg Opus の目標ビットレート（kbps）。任意。未設定なら 64（音声メモ用途で実用十分）。
# 音質を上げたい場合は 96〜256 などへ。範囲は 6〜510。
AUDIO_BITRATE_KBPS=64
