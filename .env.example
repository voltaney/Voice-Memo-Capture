# 録音した音声の送信先 Webhook URL
# クエリパラメータが必要な場合はこの URL に直接含める（例: ...?source=pc）
WEBHOOK_URL=https://example.com/webhook/xxxxx
# Basic 認証のユーザー名／パスワード。任意。
# 認証が不要な Webhook なら両方とも空（またはこの 2 行ごと削除）でよい。
BASIC_AUTH_USER=
BASIC_AUTH_PASS=
# 録音に使う入力デバイス名（部分一致で検索。未接続なら録音せず安全に停止する）。任意。
# 空（またはこの行ごと削除）なら、デバイスのチェックをせず OS の既定の入力デバイスで録音する。
# スペースを含む値は必ず "..." で囲む（囲まないと .env の解析に失敗する）
# 例: TARGET_DEVICE_NAME="Microphone (USB MICROPHONE)"
TARGET_DEVICE_NAME=
# 送信する Ogg Opus の目標ビットレート（kbps）。任意。未設定なら 64（音声メモ用途で実用十分）。
# 音質を上げたい場合は 96〜256 などへ。範囲は 6〜510。
AUDIO_BITRATE_KBPS=64
